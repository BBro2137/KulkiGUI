local function getClosestPartFromTo(from:{BasePart},part:Part):Part
	local closest = {
		["Magnitude"] = math.huge,
		["Part"] = nil
	}
	for i,port in from do
		if (port.Position-part.Position).Magnitude<closest.Magnitude then
			closest.Part = port
			closest.Magnitude = (port.Position-part.Position).Magnitude
		end
	end
	return closest.Part
end
