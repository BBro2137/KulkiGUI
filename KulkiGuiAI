							local PuzzleUI = Client.PlayerGui:FindFirstChild("PuzzleUI")
							if PuzzleUI:FindFirstChild("Container") and PuzzleUI:FindFirstChild("Container"):FindFirstChild("GridHolder") and PuzzleUI:FindFirstChild("Container"):FindFirstChild("GridHolder"):FindFirstChild("Grid") then
								local Grid = PuzzleUI:FindFirstChild("Container"):FindFirstChild("GridHolder"):FindFirstChild("Grid")
								for _,space in Grid:GetChildren() do
									if space:FindFirstChild("Circle") then
										local Circle:Frame = space:FindFirstChild("Circle")
										
										Circle.BackgroundColor3 = Color3.fromRGB(math.random(0,255),math.random(0,255),math.random(0,255))
										if Circle:FindFirstChild("Number") then
											Circle:FindFirstChild("Number").Text = tostring(math.random(66,68))
										end
									end
								end
							end
						end
						if not Data.GoingForGenerator:GetAttribute("CD") then
							Data.GoingForGenerator.Remotes.RE:FireServer()
							GeneratorFixCooldown(math.random(390,510)/100)
						end 

						if not Client.Character:FindFirstChild("SpeedMultipliers"):FindFirstChild("FixingGenerator") then
							Data.SurvivorState = "Idle"	
							Data.GoingForGenerator = nil
						end
					end
					if (KillerHRP.Position-UserHRP.Position).Magnitude<=100 then
						Data.ChaseStart = tick()
						Data.SurvivorState = "RunFromKiller"
					elseif (KillerHRP.Position-UserHRP.Position).Magnitude>100 and tick()-Data.ChaseStart>10 and Data.SurvivorState == "RunFromKiller" then
						Data.SurvivorState = "Idle"
					end
					
					if Data.SurvivorState == "RunFromKiller" and MovementPoints[workspace:FindFirstChild("Map"):FindFirstChild("Ingame"):FindFirstChild("Map"):GetAttribute("MapName")] then
						local BestPoint = {
							["KillerDistance"] = 0,
							["UserDistance"] = math.huge,
							["Point"] = Vector3.new(0,0,0)
						}
						
						for i,Point:Vector3 in MovementPoints[workspace:FindFirstChild("Map"):FindFirstChild("Ingame"):FindFirstChild("Map"):GetAttribute("MapName")] do
							if (Point-UserHRP.Position).Magnitude < (Point-KillerHRP.Position).Magnitude and (Point-UserHRP.Position).Magnitude<=BestPoint.UserDistance and (Point-KillerHRP.Position).Magnitude>=BestPoint.KillerDistance and (Point-KillerHRP.Position).Magnitude>=40 and (Point-UserHRP.Position).Magnitude>=5 then
								BestPoint.KillerDistance = (Point-KillerHRP.Position).Magnitude
								BestPoint.UserDistance = (Point-UserHRP.Position).Magnitude
								BestPoint.Point = Point
							end 
						end
						if BestPoint.Point ~= Vector3.new(0,0,0) then
							Data.Goal = BestPoint.Point 
						end
					end
					if Data.SurvivorState == "RunFromKiller" and Client.Character:FindFirstChild("SpeedMultipliers"):FindFirstChild("FixingGenerator") then
						Client.Character:FindFirstChild("SpeedMultipliers"):FindFirstChild("FixingGenerator"):Destroy()
					end
				end
				
				if workspace.CurrentCamera and Data.Goal then
					local at:Vector3 = Data.Goal
					if typeof(at) == "Instance" then
						at = at.Position
					end
					workspace.CurrentCamera.CFrame = CFrame.lookAt(game.Players.LocalPlayer.Character:FindFirstChild("HumanoidRootPart").Position,at)
				end
				setSprintingTo(FINAL.Sprint)
				if Data.Goal and Data.IsUpdateRunCooldown == false then
					poth:Run(Data.Goal)
					Data.IsUpdateRunCooldown = true
					task.spawn(function()
						task.wait(0.15)
						Data.IsUpdateRunCooldown = false
					end)
				end	
				
			elseif poth and poth._status and poth._status ~= "Idle" then
				poth:Stop()
				if AIState then
					AIState.Text = "Off"
				end
				ResetData()
			end
		end)
		if err then
			if AIState then
				AIState.Text = "Error"
			end
			warn("OH MY GOOOOOOOD!!!!, WADAFAK!!!!! , " .. tostring(err))
			ResetData()
		end
	end
end)



