local function hasKeywords(message:string,kwords)
	local found = 0
	for i,keyword:string in ipairs(kwords) do
		if typeof(keyword) ~= "string" then continue end
		if string.find(message:lower(),keyword) then
			found+=1
		end
	end
	if found>1 then
		return true
	else return false
	end
end

