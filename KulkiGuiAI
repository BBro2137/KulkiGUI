local function GetPartMovingSpeed(Part:BasePart):number --yields until the answer is found.
	local foundSpeed = 0
	local su,err = pcall(function()
		local target = Part

		local lastPos = target.Position
		local lastTime = tick()
		local teleportSpeed = nil

		local connection:RBXScriptConnection = target:GetPropertyChangedSignal("CFrame"):Connect(function()
			local newPos = target.CFrame.Position
			local now = tick()

			local dist = (newPos - lastPos).Magnitude
			local dt = now - lastTime

			-- Calculate speed in studs per second
			if dt > 0 then
				teleportSpeed = dist / dt
			end

			lastPos = newPos
			lastTime = now
		end) 
		repeat wait() until teleportSpeed
		connection:Disconnect()
	end)
	return foundSpeed
end

