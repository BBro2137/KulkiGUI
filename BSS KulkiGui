local StringGen = {}
StringGen.Alphabet = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ"
StringGen.SpecialCharacters = "1234567890!@#$%^&*()~`-_=+[{]}\|;:,<.>/?"


function StringGen.Generate(Length:number,IncludeSpecialCharacters:boolean):string
	if not IncludeSpecialCharacters then IncludeSpecialCharacters=true end
	assert(typeof(Length)=="number","The Provided string generation length isnt a number!")
	Length = math.round(Length)

	local generated = ""
	for _=1,Length do
		local char = ""
		if math.random(1,2)==1 or not IncludeSpecialCharacters then
			char = string.split(StringGen.Alphabet,"")[math.random(1,#StringGen.Alphabet)]
		else
			char = string.split(StringGen.SpecialCharacters,"")[math.random(1,#StringGen.SpecialCharacters)]
		end
		generated..=char
	end
	return generated
end

