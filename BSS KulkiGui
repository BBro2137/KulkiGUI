					local PollenPercentage = Client:FindFirstChild("CoreStats"):FindFirstChild("Pollen").Value/Client:FindFirstChild("CoreStats"):FindFirstChild("Capacity").Value
					
					if PollenPercentage<=0.95 then
						if not HRP:GetAttribute("TokenCollect") then
							if not HRP:GetAttribute("LastTokenCollect") or tick()-HRP:GetAttribute("LastTokenCollect")>=1.1 then
								HRP:SetAttribute("TokenCollect",true)
								for _,coin:BasePart in workspace.Collectibles:GetChildren() do
									if coin:IsA("BasePart") and (game.Players.LocalPlayer.Character.HumanoidRootPart.Position-coin.Position).Magnitude<=35 then
										HRP.CFrame = coin.CFrame
										task.wait(0.65)
									end
								end
								HRP:SetAttribute("LastTokenCollect",tick())
								HRP:SetAttribute("TokenCollect",false)
							end
						end
						if not HRP:GetAttribute("PollenFieldRotation") then
							HRP:SetAttribute("PollenFieldRotation",true)
							for _,flower in pairs(workspace.Flowers:GetChildren()) do
								PollenPercentage = Client:FindFirstChild("CoreStats"):FindFirstChild("Pollen").Value/Client:FindFirstChild("CoreStats"):FindFirstChild("Capacity").Value
								if flower.Name:find(fieldData[options.SelectedField].FlowerFindName) and (fieldData[options.SelectedField].Position-flower.Position).Magnitude < 75 and math.random(1,2)==1 then 
									HRP.CFrame = flower.CFrame 
									wait() 
								end
								if HRP:GetAttribute("TokenCollect") then repeat wait() until not HRP:GetAttribute("TokenCollect") end
								if PollenPercentage >0.95 or not canRunUpdateLoop then break end
								if not HRP:GetAttribute("ToolCD") or tick()-HRP:GetAttribute("ToolCD")>=0.25 then
									for i=0,2,1 do game.ReplicatedStorage:WaitForChild("Events"):WaitForChild("ToolCollect"):FireServer() end
									HRP:SetAttribute("ToolCD",tick())
								end
								
							end
							HRP:SetAttribute("PollenFieldRotation",false)
						end
					elseif not HRP:GetAttribute("HoneyMaking") then
						print("Started honey making")
						
						local StartingPollen = Pollen
						local Started = tick()
						HRP:SetAttribute("HoneyMaking",true)
						HRP.CFrame = Hive.SpawnPos.Value
						task.wait(0.75)
						game:GetService("ReplicatedStorage"):WaitForChild("Events"):WaitForChild("PlayerHiveCommand"):FireServer(unpack({"ToggleHoneyMaking"}))

						repeat 
							wait(0.5)
							HRP.CFrame = Hive.SpawnPos.Value
							Pollen = Client:FindFirstChild("CoreStats"):FindFirstChild("Pollen").Value 
							if tick()-Started>=3.5 and StartingPollen == Pollen then
								game:GetService("ReplicatedStorage"):WaitForChild("Events"):WaitForChild("PlayerHiveCommand"):FireServer(unpack({"ToggleHoneyMaking"}))
								print("retry honey making")
								Started = tick()
							end
						until Pollen<=0 and not isMakingHoney() or not canRunUpdateLoop or not options.Macro
						HRP:SetAttribute("HoneyMaking",false)
						print("Ended honey making")
					end
				end)
			end
		end)
		task.wait()
	end
end)

