local function createOption(displayed:string,OptionType:string,OptionIndex:string,ForTab:string,default:string,FunctionToggle:boolean,Func,onlyOnMap:string,arg1:any)
	local realbtt = nil

	if not default then default = options[OptionIndex] end
	local function can()
		if onlyOnMap then
			if workspace:FindFirstChild("Map"):FindFirstChild("Ingame"):FindFirstChild("Map") and workspace:FindFirstChild("Map"):FindFirstChild("Ingame"):FindFirstChild("Map"):GetAttribute("MapName") == onlyOnMap then
				return true
			else
				return false
			end
		else
			return true
		end
	end
	if OptionType:lower() == "toggle" then
		local btt = Instance.new("TextButton")
		if default == nil or default == false then
			default = "OFF"
		elseif default == true then
			default = "ON"
		end
		btt.Text = displayed .. " (" .. tostring(default) .. ")"
		btt.MouseButton1Click:Connect(function()
			if can() == true then
				if FunctionToggle == true then
					options[OptionIndex] = not options[OptionIndex]
				end
				local to = " (ON)"
				if options[OptionIndex] == false then
					to = " (OFF)"
				end
				if Func then
					Func(arg1)
				end
				btt.Text = displayed .. to				
			end
		end)
		realbtt = btt
	elseif OptionType:lower() == "use" then
		local btt = Instance.new("TextButton")
		btt.Text = displayed
		btt.MouseButton1Click:Connect(function()
			if can() == true then
				if Func then
					Func(arg1)
				end				
			end
		end)
		realbtt = btt
	elseif OptionType:lower() == "inputnumber" then
		local frame = InputTypeFrame:Clone()
		local input = frame:FindFirstChildWhichIsA("TextBox")
		local text = frame:FindFirstChildWhichIsA("TextLabel")
		input.Text = tostring(options[OptionIndex])
		input.PlaceholderText = "Input an number"
		text.Text = displayed
		input.FocusLost:Connect(function(enterPressed,IObject)
			if not enterPressed or not tonumber(input.Text) or tonumber(input.Text) ~= math.floor(tonumber(input.Text)) then
				input.Text = ""
			else
				options[OptionIndex] = tonumber(input.Text)
			end
		end)
		frame.Parent = MainFrame:FindFirstChild(ForTab)
	elseif OptionType:lower() == "inputtext" then
		local frame = InputTypeFrame:Clone()
		local input = frame:FindFirstChildWhichIsA("TextBox")
		local text = frame:FindFirstChildWhichIsA("TextLabel")
		input.Text = tostring(options[OptionIndex])
		input.PlaceholderText = "Input text"
		text.Text = displayed
		input.FocusLost:Connect(function(enterPressed,IObject)
			if not enterPressed or not tostring(input.Text) then
				input.Text = ""
			else
				options[OptionIndex] = tostring(input.Text)
			end
		end)
		frame.Parent = MainFrame:FindFirstChild(ForTab)
	end
	if realbtt then
		realbtt.TextScaled = true
		realbtt.Size = UDim2.new(1, 0,0.003, 0)
		realbtt.BackgroundColor3 = Color3.fromRGB(200, 200, 200)
		realbtt.Parent = MainFrame:FindFirstChild(ForTab)
	end
	return realbtt
end

