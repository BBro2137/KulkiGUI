local CanExecuteScript = false

pcall(function()
	local Unsupported = {
		["Madium"] = "it randomly crashes :c i gave up on fixing it",
		["Wave"] = "crypt library does some shenanigans",
		["Xeno"] = "xeno doesnt support hookfunction, require and a lot more basic functions",
		["Solara"] = "solara doesnt support hookfunction, require and a lot more basic functions",
	}
	local Supported = {
		"Real","Volt","Nexomia.win"
	}

	local ExecName,_ = identifyexecutor()

	if not table.find(Supported,ExecName) then
		local Waiting = nil

		local sGUI = Instance.new("ScreenGui")
		local Frame = Instance.new("Frame")
		local Stroke = Instance.new("UIStroke")
		local Text = Instance.new("TextLabel")

		Frame.AnchorPoint = Vector2.new(0.5,0.5)
		Frame.Position = UDim2.new(0.5,0,0.5,0)
		Frame.BackgroundColor3 = Color3.fromRGB(0,0,0)
		Frame.Size = UDim2.new(0.5,0,0.45,0)
		Frame.Parent = sGUI

		Stroke.Color = Color3.fromRGB(255,255,255)
		Stroke.StrokeSizingMode = Enum.StrokeSizingMode.ScaledSize
		Stroke.Thickness = 0.01
		Stroke.Parent = Frame

		Text.TextScaled = true
		Text.Text = "Your executor (" .. ExecName .. ") "
		Text.Size = UDim2.new(1,0,0.75)
		Text.BackgroundTransparency = 1
		Text.TextColor3 = Color3.fromRGB(0,0,0)
		local TextStroke = Stroke:Clone()
		TextStroke.Parent = Text
		TextStroke.Thickness = 0.05
		Text.Parent = Frame

		if Unsupported[ExecName] then
			Text.Text ..= "is officialy NOT SUPPORTED, this means that the script will either crash or not work at all."
		else
			Text.Text ..= "WAS NOT TESTED AT ALL, this MIGHT mean that the script will randomly crash or just not work at all, but it MIGHT not."
		end

		local Yes = Instance.new("TextButton")
		Yes.Text = "YES"
		Yes.BackgroundColor3 = Color3.fromRGB(0,255,0)
		Yes.Size = UDim2.new(0.17,0,0.15,0)
		Yes.TextScaled = true
		Yes.Parent = Frame
		Yes.Position = UDim2.new(0,0,0.8,0)

		local No = Yes:Clone()
		No.Text = "NO"
		No.BackgroundColor3 = Color3.fromRGB(255,0,0)
		No.Position = UDim2.new(0.83,0,0.8,0)
		No.Parent = Frame
		Text.Text ..= " do you want to still execute the script to see if it works?"


		sGUI.Parent = game:GetService("CoreGui")
		Yes.MouseButton1Click:Connect(function()
			Waiting = 1
		end)
		No.MouseButton1Click:Connect(function()
			Waiting = 2
		end)

		repeat task.wait() until Waiting ~= nil
		sGUI:Destroy()
		if Waiting == 1 then
			CanExecuteScript = true
		end
	else
		CanExecuteScript = true
	end
end)
if not CanExecuteScript then return end

