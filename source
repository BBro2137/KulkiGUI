export type InputTypeConfig = {
	Min:number,
	Max:number,
	AllowedStrings:{string}
}

local function IsInArray(array:{},value:any):boolean
	for index,v in array do
		if v == value then
			return true
		end
	end
	return false
end

local HoveringOverTTOption = nil
local function createOption(displayed,OptionType,OptionIndex,ForTab,default,FunctionToggle,Func,onlyOnMap,arg1,InputTypeConfig:InputTypeConfig)
	local realbtt = nil
	
	if not default then default = options[OptionIndex] end
	local function can()
		if onlyOnMap then
			if workspace:FindFirstChild("Map"):FindFirstChild("Ingame"):FindFirstChild("Map") and workspace:FindFirstChild("Map"):FindFirstChild("Ingame"):FindFirstChild("Map"):GetAttribute("MapName") == onlyOnMap then
				return true
			else
				return false
			end
		else
			return true
		end
	end
	local TTHitbox:Frame = nil
	if OptionType:lower() == "toggle" then
		local btt = Instance.new("TextButton")
		if default == nil or default == false then
			default = "OFF"
		elseif default == true then
			default = "ON"
		end
		btt.Text = displayed .. " (" .. tostring(default) .. ")"
		btt.MouseButton1Click:Connect(function()
			if can() == true then
				if FunctionToggle == true then
					options[OptionIndex] = not options[OptionIndex]
				end
				local to = " (ON)"
				if options[OptionIndex] == false then
					to = " (OFF)"
				end
				if Func then
					Func(arg1)
				end
				btt.Text = displayed .. to				
			end
		end)
		realbtt = btt
	elseif OptionType:lower() == "use" then
		local btt = Instance.new("TextButton")
		btt.Text = displayed
		btt.MouseButton1Click:Connect(function()
			if can() == true then
				if Func then
					Func(arg1)
				end				
			end
		end)
		realbtt = btt
	elseif OptionType:lower() == "inputnumber" then
		local frame = InputTypeFrame:Clone()
		local input = frame:FindFirstChildWhichIsA("TextBox")
		local text = frame:FindFirstChildWhichIsA("TextLabel")
		input.Text = tostring(options[OptionIndex])
		input.PlaceholderText = "Input an number"
		text.Text = displayed
		input.FocusLost:Connect(function(enterPressed,IObject)
			local InBounds = true
			if InputTypeConfig and InputTypeConfig.Max and InputTypeConfig.Min and tonumber(input.Text) and math.clamp(tonumber(input.Text),InputTypeConfig.Min,InputTypeConfig.Max) ~= tonumber(input.Text) then
				InBounds = false
			end
			if not enterPressed or not tonumber(input.Text) or tonumber(input.Text) ~= math.floor(tonumber(input.Text)) or not InBounds then
				input.Text = ""
			else
				options[OptionIndex] = tonumber(input.Text)
			end
		end)
		frame.Parent = MainFrame:FindFirstChild(ForTab)
		TTHitbox = frame
	elseif OptionType:lower() == "inputtext" then
		local frame = InputTypeFrame:Clone()
		local input = frame:FindFirstChildWhichIsA("TextBox")
		local text = frame:FindFirstChildWhichIsA("TextLabel")
		input.Text = tostring(options[OptionIndex])
		input.PlaceholderText = "Input text"
		text.Text = displayed
		input.FocusLost:Connect(function(enterPressed,IObject)
			local Allowed = true
			if InputTypeConfig and InputTypeConfig.AllowedStrings and not IsInArray(InputTypeConfig.AllowedStrings,input.Text) then
				Allowed = false
			end
			
			if not enterPressed or not tostring(input.Text) or not Allowed then
				input.Text = ""
			else
				options[OptionIndex] = tostring(input.Text)
			end
		end)
		frame.Parent = MainFrame:FindFirstChild(ForTab)
		TTHitbox = frame
	end
	if realbtt then
		realbtt.TextScaled = true
		realbtt.Size = UDim2.new(1, 0,0.003, 0)
		realbtt.BackgroundColor3 = Color3.fromRGB(200, 200, 200)
		realbtt.Parent = MainFrame:FindFirstChild(ForTab)
		TTHitbox = realbtt
	end
	if TTHitbox then
		if OptionToolTips[displayed] then
			TTHitbox.Name = displayed
			TTHitbox.MouseEnter:Connect(function(x,y)
				HoveringOverTTOption = TTHitbox
				TTHitbox.MouseLeave:Wait()
				HoveringOverTTOption = nil
			end)
		end
	else
		warn("Created option with no avaible hitbox? (OPTION_DISPLAY: "..tostring(displayed)..")")
	end
	return realbtt
end

local function addTabToUI(layoutOrder:number,Background:Color3,text:string,SetsTo:string)
	local btt = Instance.new("TextButton")
	btt.LayoutOrder = layoutOrder
	btt.Size = UDim2.new(0.496, 0,0.184, 0)
	btt.BackgroundColor3 = Background
	btt.Text = text
	btt.Parent = FR_tabs
	btt.TextScaled = true
	local tab = FR_options:Clone()
	tab.Parent = MainFrame
	tab.Name = SetsTo
