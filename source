local packed = false
local function HasCharacter(char:string)
	local returnin = false
	if game:GetService("Players").LocalPlayer.PlayerData.Purchased.Killers:FindFirstChild(char) or game:GetService("Players").LocalPlayer.PlayerData.Purchased.Survivors:FindFirstChild(char) then
		returnin = true
	end
	return returnin
end
local function PatchLockedCharacters()
	if packed == false then
		options.UnUsedValue = false
		local f = false
		for i,char in game:GetService("ReplicatedStorage").Assets.Killers:GetChildren() do
			if string.find(char.Name,"#")  then
				f = true
				break
			end
		end
		if f == true then	
			for i,char in game:GetService("ReplicatedStorage").Assets.Killers:GetChildren() do
				if string.find(char.Name,"#")  then
					char.Name = string.gsub(char.Name, "#", "")
				end
			end
			for i,char in game:GetService("ReplicatedStorage").Assets.Survivors:GetChildren() do
				if string.find(char.Name,"!")  then
					char.Name = string.gsub(char.Name, "#", "")
				end
			end	
		end
		packed = true
	end
end	

local function GetCharacter(char:string,xp:number,killer:boolean)
	local int = Instance.new("IntValue")
	int.Value = xp
	int.Name = char
	if killer then
		int.Parent = game:GetService("Players").LocalPlayer.PlayerData.Purchased.Killers	
	else
		int.Parent = game:GetService("Players").LocalPlayer.PlayerData.Purchased.Survivors
	end
end

