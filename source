local function AddESP(AddFor:Model|BasePart,OutlineColor,FillColor,OutlineTransparency,FillTransparency,DepthMode:Enum.HighlightDepthMode)
	if not DepthMode then DepthMode = Enum.HighlightDepthMode.AlwaysOnTop end
	if not OutlineColor then OutlineColor = Color3.fromRGB(255,255,255) end
	if not FillColor then FillColor = Color3.fromRGB(255,255,255) end
	if not AddFor then return end
	if not OutlineTransparency then OutlineTransparency = 0 end
	if not FillTransparency then FillTransparency = 0 end
	local Highlight = nil
	
	if options.GlobalESPMode == "Shaders" then
		Highlight = Instance.new("Highlight")
		Highlight.DepthMode = DepthMode
		Highlight.Adornee = AddFor
		Highlight.OutlineColor = OutlineColor
		Highlight.FillColor = FillColor
		Highlight.OutlineTransparency = OutlineTransparency
		Highlight.FillTransparency = FillTransparency
	end
	
	if options.ESPTracers and AddFor:FindFirstChild("Head") and AddFor:FindFirstChild("HumanoidRootPart") and AddFor:FindFirstChildWhichIsA("Humanoid") and AddFor:FindFirstChildWhichIsA("Humanoid").Health>0 then
		local Tracer = Instance.new("BoxHandleAdornment")
		local OwnerValue = Instance.new("ObjectValue")
		OwnerValue.Value = AddFor
		OwnerValue.Parent = Tracer
		Tracer.AlwaysOnTop = true
		Tracer.Shading = Enum.AdornShading.XRay
		Tracer.Color3 = FillColor
		Tracer.Name = StringGen.Generate(5,true)
		Tracer.Adornee = ZeroPositionPart
		Tracer.Parent = TracerFolder
	end
	
	Highlight.Name = AddFor.Name
	Highlight.Parent = ESPFolder
	return Highlight
end

