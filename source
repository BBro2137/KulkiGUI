local function placeOpSentry(loc:CFrame)
	if Client.Character and Client.Character.Name == "Builderman" and game.Players.LocalPlayer.PlayerGui:FindFirstChild("MainUI"):WaitForChild("AbilityContainer"):WaitForChild("Sentry"):WaitForChild("CooldownTime").Text == "" then
		local hrp:BasePart = Client.Character:FindFirstChild("HumanoidRootPart")
		if not hrp then return end
		local s = hrp.CFrame
		local BV = Instance.new('BodyVelocity')
		BV.Parent = Client.Character:FindFirstChild("HumanoidRootPart")
		BV.Velocityelocity = Vector3.new(0, 0, 0)
		BV.MaxForce = Vector3.new(9e9, 9e9, 9e9)
		task.wait(1)
		hrp.CFrame = loc
		task.wait(1)
		local args = {
			"UseActorAbility",
			"Sentry"
		}
		game.ReplicatedStorage:FindFirstChild("Modules"):FindFirstChild("Network"):FindFirstChild("RemoteEvent"):FireServer(unpack(args))
		task.wait(3)
		BV:Destroy()
		hrp.CFrame = s
	end
end

